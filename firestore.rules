rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for role checks
    function isAuthenticated() {
      return request.auth != null;
    }
    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }
    function isSuperAdmin() {
      return hasRole('super_admin');
    }
    function isStaffOrAbove() {
      return hasRole('super_admin') || hasRole('regional_admin') || hasRole('staff');
    }

    // 1. Users collection
    // Users can read/write their own profile. Staff/Admins can read/write all.
    match /users/{userId} {
      allow read, update, delete: if isStaffOrAbove() || request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId;
    }

    // 2. Institutions collection
    // Public read for verified listings. Institution Admins can update their own. Admins can do all.
    match /institutions/{institutionId} {
      allow read: if true; 
      allow create: if isStaffOrAbove();
      allow update: if isStaffOrAbove() || (hasRole('institution_admin') && request.auth.token.institutionId == institutionId);
      allow delete: if isSuperAdmin();
    }

    // 3. Claims collection
    // Users can create claims for institutions. Staff/Admins can read/update.
    match /claims/{claimId} {
      allow create: if isAuthenticated();
      allow read: if isStaffOrAbove() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isStaffOrAbove();
    }

    // 4. Jobs collection
    // Public read. Employer/Institution admins can create/update.
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if hasRole('employer_admin') || hasRole('institution_admin') || isStaffOrAbove();
      allow update, delete: if isStaffOrAbove() || 
        ((hasRole('employer_admin') || hasRole('institution_admin')) && resource.data.employerId == request.auth.uid);
    }

    // 5. Messages / Inbox collection
    // Users can read/write messages where they are a participant.
    match /messages/{messageId} {
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow read, update: if isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }
  }
}
